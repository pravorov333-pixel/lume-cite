# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Your numeric Telegram chat ID — where proofs/payment requests are sent for review.
# Get it by messaging @userinfobot.
ADMIN_CHAT_ID=000000000

# Same Supabase project as the website. Use the SERVICE ROLE key here
# (Project Settings -> API -> service_role) — never the anon key, and
# never expose this file/key in the browser or commit it to git.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Channels required for the free subscription.
# Both are PRIVATE (invite-link only, no @username), so checking membership
# needs the numeric chat id (looks like -1001234567890), not the link.
#
# How to get it:
#   1. Add the bot to the channel as admin (needed anyway, so it can check members).
#   2. Post anything in the channel, then forward that post to @getidsbot
#      (or @username_to_id_bot) — it replies with the numeric channel id.
#   3. Paste that id below. Until this is set, the subscription check will
#      always say "not subscribed" (the bot warns about this on startup).
CHANNEL_1_ID=
CHANNEL_1_URL=https://t.me/+iTX6597n68UyYTJi
CHANNEL_1_NAME=LumeVisuals

CHANNEL_2_ID=
CHANNEL_2_URL=https://t.me/+oH_SdoyHrWk1NDli
CHANNEL_2_NAME=OneCrypto

# Social links shown in "Наши соцсети"
TELEGRAM_CHANNEL_URL=https://telegram.me/+iTX6597n68UyYTJi
TIKTOK_URL=https://tiktok.com/@lume_client

# Support contact shown by the "Поддержка" button
SUPPORT_USERNAME=@cevtu

# Crypto payment addresses
TON_WALLET=UQA694x1Qb0K5oJwG-xEKcEdh4utQIR9945o3T0TUZBAAuHR
USDT_ERC20_WALLET=0x45266e7d59969a8df9c54cd1f85078c6b2469e41
USDC_ERC20_WALLET=0x45266e7d59969a8df9c54cd1f85078c6b2469e41

# Free-task rewards (days of free subscription granted on approval)
FREE_TASK_QUICK_VIDEO_DAYS=14
FREE_TASK_REVIEW_VIDEO_DAYS=90

# Telegram Stars: how many Stars equal $1. Telegram has no public live
# exchange-rate API for Stars, so this is a manually-set approximation —
# update it here if Telegram's own pricing changes.
STARS_PER_USD=75
