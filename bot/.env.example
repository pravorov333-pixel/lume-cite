# Telegram bot token from @BotFather
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Your numeric Telegram chat ID — where proofs/payment requests are sent for review.
# Get it by messaging @userinfobot.
ADMIN_CHAT_ID=000000000

# Same Supabase project as the website. Use the SERVICE ROLE key here
# (Project Settings -> API -> service_role) — never the anon key, and
# never expose this file/key in the browser or commit it to git.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Channels required for the free subscription (with the @ or as -100... chat id)
CHANNEL_1=@LumeVisuals
CHANNEL_2=@OneCrypto

# Social links shown in "Наши соцсети"
TELEGRAM_CHANNEL_URL=https://telegram.me/+iTX6597n68UyYTJi
TIKTOK_URL=https://tiktok.com/@lume_client

# Support contact shown by the "Поддержка" button
